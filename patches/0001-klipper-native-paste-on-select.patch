+void DeclarativeHistoryModel::selectAndPaste(const QString &uuid)
+{
+    moveToTop(uuid);
+
+    if (KlipperSettings::pasteOnSelect()) {
+        const QString seqStr = KlipperSettings::pasteKeySequence();
+        const QKeySequence seq = KeyMapper::keySequenceFromString(seqStr);
+        if (seq.isEmpty()) {
+            return;
+        }
+        // Delay ensures popup is unmapped and target window regains active focus before keystroke injection
+        QTimer::singleShot(150, this, [seq]() {
+            SyntheticKeyboard::self()->sendKeySequence(seq);
+        });
+    }
+}

+
+    KLIPPER_EXPORT quint32 toX11KeySym(Qt::Key key);
+    KLIPPER_EXPORT QList<quint32> modifiersToX11KeySyms(Qt::KeyboardModifiers modifiers);
+
+    KLIPPER_EXPORT QKeySequence keySequenceFromString(const QString &str);
+}
+
+#endif // KEYMAPPER_H
